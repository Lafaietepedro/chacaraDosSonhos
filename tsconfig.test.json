{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "es2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".test-build",
    "rootDir": ".",
    "noEmit": false,
    "incremental": false,
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "lib/rate-limit.ts",
    "lib/services/pricing.ts",
    "lib/validation/booking.ts",
    "lib/validation/contact.ts"
  ]
}
